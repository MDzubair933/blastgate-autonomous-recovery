{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlastGate Decision Receipt Schema",
  "description": "Deterministic receipt generated by the Lambda Remediation Broker for every proposal evaluation. Separates authorization decision from execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "incident_id",
    "action_id",
    "target_task_arn",
    "catalog_version",
    "policy_version",
    "decision",
    "reason_code",
    "execution_status",
    "aws_request_id",
    "recorded_at",
    "rule_results"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^dec-[a-f0-9]{8,36}$"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc-[a-f0-9]{8,36}$"
    },
    "action_id": {
      "type": "string",
      "enum": [
        "REPLACE_UNHEALTHY_ECS_WORKER"
      ]
    },
    "target_task_arn": {
      "type": "string",
      "pattern": "^arn:aws:ecs:[a-z0-9-]+:[0-9]{12}:task/blastgate-sandbox/[a-f0-9]{32}$"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "ERROR",
        "UNKNOWN"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "AUTH_APPROVED",
        "ERR_UNAUTHORIZED_ACTION",
        "ERR_TARGET_NOT_ALLOWLISTED",
        "ERR_CAPACITY_QUORUM_VIOLATION",
        "ERR_TARGET_NOT_UNHEALTHY",
        "ERR_STALE_TELEMETRY",
        "ERR_COOLDOWN_ACTIVE",
        "ERR_UNREGISTERED_PROCEDURE",
        "ERR_AUDIT_WRITE_FAILED",
        "ERR_INTERNAL_EXCEPTION",
        "ERR_FAIL_CLOSED_TIMEOUT"
      ]
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "SUBMITTED",
        "VERIFIED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "aws_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "rule_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "R1_allowlist",
        "R2_capacity",
        "R3_telemetry",
        "R4_cooldown",
        "R5_catalog",
        "R6_audit",
        "R7_authority",
        "R8_idempotency"
      ],
      "properties": {
        "R1_allowlist": {
          "type": "boolean"
        },
        "R2_capacity": {
          "type": "boolean"
        },
        "R3_telemetry": {
          "type": "boolean"
        },
        "R4_cooldown": {
          "type": "boolean"
        },
        "R5_catalog": {
          "type": "boolean"
        },
        "R6_audit": {
          "type": "boolean"
        },
        "R7_authority": {
          "type": "boolean"
        },
        "R8_idempotency": {
          "type": "boolean"
        }
      }
    },
    "audit_persisted": {
      "type": "boolean"
    },
    "audit_warning": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
